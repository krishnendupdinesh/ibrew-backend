# =============================================================================
# ibrew-backend Environment Variables (Vercel Serverless / Production)
# =============================================================================

# Server Port (used in local development)
PORT=5001
NODE_ENV=production

# Frontend URL allowed by CORS (e.g., https://your-frontend.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# MySQL Database (mysql2 pool with SSL)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=true

# Security & Authentication (MUST match ibrew-web JWT_SECRET)
JWT_SECRET=your_jwt_secret_min_32_characters

# Admin Credentials (initial seed & identity)
ADMIN_NAME=ibrew Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# Cloudinary (Media / Product Images Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Razorpay Online Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM=your-email@example.com

# Business Tax Details for GST Invoices (optional)
BUSINESS_GSTIN=29AAAAI0000A1Z5
BUSINESS_PAN=AAAAI0000A
