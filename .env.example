# ========================================================
# IBREW BACKEND PRODUCTION ENVIRONMENT TEMPLATE (Render)
# ========================================================
# Set these environment variables in your Render Web Service dashboard.
# Do NOT commit actual passwords or private keys to source control.

PORT=5001
NODE_ENV=production

# Frontend URL(s) for CORS (comma-separated if multiple, e.g. https://your-app.vercel.app,http://localhost:3000)
CLIENT_URL=https://your-app.vercel.app

# MySQL Database Configuration
# DATABASE_URL=mysql://user:password@host:3306/imaans_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_DATABASE=imaans_db

# Security & Authentication:
# IMPORTANT: Frontend (ibrew-web) and backend (ibrew-backend) MUST use the exact same JWT_SECRET.
# Must be at least 32 characters long. The backend will refuse to start if this is missing.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Administrator Credentials (used for initial bootstrap and admin identity)
ADMIN_NAME=ibrew Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ibrew.com
ADMIN_PASSWORD=replace_with_secure_admin_password

# Razorpay Online Payment Gateway
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-email@gmail.com

# Business Tax Details for GST Invoices
BUSINESS_GSTIN=29AAAAI0000A1Z5
BUSINESS_PAN=AAAAI0000A
