# ========================================================
# IBREW BACKEND PRODUCTION ENVIRONMENT TEMPLATE (Render)
# ========================================================
# Set these environment variables in your Render Web Service dashboard.
# Do NOT commit actual passwords or private keys to source control.

PORT=5001
NODE_ENV=production

# Frontend URL on Vercel (without trailing slash) for CORS & Cookies
CLIENT_URL=https://your-app.vercel.app

# MySQL Database on Render (provide DATABASE_URL or individual MYSQL_* vars)
# DATABASE_URL=mysql://user:password@host:3306/imaans_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=imaans_db

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Administrator Credentials
ADMIN_NAME=ibrew Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ibrew.com
ADMIN_PASSWORD=replace_with_secure_admin_password

